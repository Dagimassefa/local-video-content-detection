{
  "name": "local-video-content-detection",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-only video content detection. All inference runs on-device; no network calls, no server.",
  "scripts": {
    "models": "node scripts/fetch-models.mjs",
    "postinstall": "node scripts/fetch-models.mjs --soft",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "bench": "vite build && node scripts/bench.mjs",
    "verify": "vite build && node scripts/verify.mjs",
    "matrix": "vite build && node scripts/matrix.mjs",
    "mobile": "vite build && node scripts/serve-lan.mjs",
    "bench:only": "node scripts/bench.mjs",
    "verify:only": "node scripts/verify.mjs",
    "matrix:only": "node scripts/matrix.mjs",
    "mobile:only": "node scripts/serve-lan.mjs",
    "eval:violence": "node scripts/eval-violence-model.mjs",
    "models:violence": "node scripts/fetch-models.mjs --violence"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.28.0",
    "mp4box": "^2.4.1",
    "nsfwjs": "^4.3.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
